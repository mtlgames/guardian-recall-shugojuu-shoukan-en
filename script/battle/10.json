 "strings": [
  {
   "id": "g13.10.000",
   "jp": "（わたしをしゅごせよ）\n守護獣を常にマスターの側に置き、\n近くの敵のみを攻撃させる。\n",
   "en": "",
   "slots": [
    0
   ],
   "pre": 1,
   "tbl": "jp-"
  },
  {
   "id": "g13.10.001",
   "jp": "（こうげきせよ）\n守護獣を積極的に敵の方へ進ませ、\n攻撃をしかけさせる。\n",
   "en": "",
   "slots": [
    1
   ],
   "pre": 1
  },
  {
   "id": "g13.10.002",
   "jp": "（せっきんしてこうげきせよ）\n守護獣の攻撃方法を接近戦だけに限定\nして、攻撃をしかけさせる。\n",
   "en": "",
   "slots": [
    2
   ],
   "pre": 1
  },
  {
   "id": "g13.10.003",
   "jp": "（とおくからこうげきせよ）\n守護獣の攻撃方法を投射戦だけに限定\nして、攻撃をしかけさせる。\n",
   "en": "",
   "slots": [
    3
   ],
   "pre": 1
  },
  {
   "id": "g13.10.004",
   "jp": "（とつげきせよ）\n敵に体当たり攻撃をしかけさせる。\n攻撃対象がいない場合は実行しない。\n",
   "en": "",
   "slots": [
    4
   ],
   "pre": 1
  },
  {
   "id": "g13.10.005",
   "jp": "（きりょくをいやせ）\n守護獣に味方ユニットのＳＰを回復\nさせる。\n",
   "en": "",
   "slots": [
    5
   ],
   "pre": 1
  },
  {
   "id": "g13.10.006",
   "jp": "（いどうせよ）\n守護獣をＭＡＰ上の指定した位置に\n移動させる。攻撃はできない。\n",
   "en": "",
   "slots": [
    6
   ],
   "pre": 1
  },
  {
   "id": "g13.10.007",
   "jp": "（なにもするな！）\n守護獣をその場で休ませる。攻撃も\n行わない。\n",
   "en": "",
   "slots": [
    7
   ],
   "pre": 1
  },
  {
   "id": "g13.10.008",
   "jp": "（せっきんせんりょくをたかめよ）\n守護獣にパワーをたくわえさせる。\n次のターンのみ接近戦力が上昇する。\n",
   "en": "",
   "slots": [
    8
   ],
   "pre": 1,
   "tbl": "jp-"
  },
  {
   "id": "g13.10.009",
   "jp": "（とうしゃせんりょくをたかめよ）\n守護獣にパワーをたくわえさせる。\n次のターンのみ投射戦力が上昇する。\n",
   "en": "",
   "slots": [
    9
   ],
   "pre": 1,
   "tbl": "jp-"
  },
  {
   "id": "g13.10.010",
   "jp": "（ちゆりょくをたかめよ）\n守護獣にパワーをたくわえさせる。\n次のターンのみ治癒力が上昇する。\n",
   "en": "",
   "slots": [
    10
   ],
   "pre": 1,
   "tbl": "jp-"
  },
  {
   "id": "g13.10.011",
   "jp": "（ぼうぎょりょくをたかめよ）\n守護獣にパワーをたくわえさせる。\n次のターンのみ防御力が上昇する。\n",
   "en": "",
