 "strings": [
  {
   "id": "g13.14.000",
   "jp": "あきらめちゃダメだよ！\nもっかいがんばろうよ！\nきっと大丈夫。\n{wait}",
   "en": "",
   "slots": [
    0
   ],
   "pre": 2
  },
  {
   "id": "g13.14.001",
   "jp": "　　　　　\nこがんこつであきらめるんじゃなかよ。\n{wait}",
   "en": "",
   "slots": [
    1
   ],
   "pre": 1
  },
  {
   "id": "g13.14.002",
   "jp": "ちょっと焦りすぎたわ・・・\nでも次はやれる！\n{wait}",
   "en": "",
   "slots": [
    2
   ],
   "pre": 1
  },
  {
   "id": "g13.14.003",
   "jp": "大丈夫です、\n次はきっとうまくいきます。\n私の勘、当たるんです。\n{wait}",
   "en": "",
   "slots": [
    3
   ],
   "pre": 1
  },
  {
   "id": "g13.14.004",
   "jp": "なーに、もう一回やってみるさ。\n案外、あっさり勝てるかもしれないよ。\n{wait}",
   "en": "",
   "slots": [
    4
   ],
   "pre": 1,
   "tbl": "jp-"
  },
  {
   "id": "g13.14.005",
   "jp": "もっと慎重にやんなきゃね。\n人のこと言えないけど・・・。\n{wait}",
   "en": "",
   "slots": [
    5
   ],
   "pre": 1
  },
  {
   "id": "g13.14.006",
   "jp": "終わったの・・・？\nでも・・・まだ・・・！\n{wait}",
   "en": "",
   "slots": [
    6
   ],
   "pre": 1
  },
  {
   "id": "g13.14.007",
   "jp": "やっぱり戦うの怖いよ。\nでもあたし、がんばるから！\n{wait}",
   "en": "",
   "slots": [
    7
   ],
   "pre": 1
  },
  {
   "id": "g13.14.008",
   "jp": "　　　　　\nだめよ・・・まだ足りないわ。\n{wait}",
   "en": "",
   "slots": [
    8
   ],
   "pre": 1
  },
  {
   "id": "g13.14.009",
   "jp": "あーら、まだやる気？\n死んじゃっても知らないわよ？\n{wait}",
   "en": "",
   "slots": [
    9
   ],
   "pre": 1,
   "tbl": "jp-"
  },
  {
   "id": "g13.14.010",
   "jp": "まだ刃向かう気？\nムダだというのに\n・・・わからないのね。\n{wait}",
   "en": "",
   "slots": [
    10
   ],
   "pre": 1
  },
  {
   "id": "g13.14.011",
   "jp": "我は七龍の長、皇龍の魂を持つ者。\n何人たりとも我が浄化を妨げることは\nできぬ。すべては運命なのだ・・・。\n{wait}",
   "en": "",
   "slots": [
    11
   ],
   "pre": 1
  },
  {
   "id": "g13.14.012",
   "jp": "まいったまいった。\nやっぱ、ただ突っ込むだけじゃダメ\nだよね。反省反省。\n{wait}",
   "en": "",
   "slots": [
    12
   ],
   "pre": 1
  },
  {
   "id": "g13.14.013",
   "jp": "戦略ミス？　私もまだまだね・・・\nみんな、もう一度きたえ直すわよ！\n{wait}",
   "en": "",
   "slots": [
    13
   ],
   "pre": 1
  },
  {
   "id": "g13.14.014",
   "jp": "ヒーローの魂は不撓不屈！\nくじけずがんばるですっ！\n{wait}",
   "en": "",
   "slots": [
    14
   ],
   "pre": 1,
   "tbl": "jp-"
  },
  {
   "id": "g13.14.015",
   "jp": "そんなに落ち込まないで・・・\nもっと強くならなきゃ、ね？\n{wait}",
   "en": "",
   "slots": [
    15
   ],
   "pre": 1
  },
  {
   "id": "g13.14.016",
   "jp": "うっそぉ、みんな何やってんのよぉ～。\nしっかりしてよ、もお～。\n・・・え、あたし？\n{wait}",
   "en": "",
   "slots": [
    16
   ],
   "pre": 1
  },
  {
   "id": "g13.14.017",
   "jp": "なんでさー・・・。\nでもま、くじけないでさ。\nもっかいくらいやってみよーよ。\n{wait}",
   "en": "",
   "slots": [
    17
   ],
   "pre": 1,
   "tbl": "jp-"
  },
  {
   "id": "g13.14.018",
   "jp": "負けは負けね・・・。\nでも、あーんな奴らにやられるなんて！\nは・ら・た・つ・～。\n{wait}",
   "en": "",
   "slots": [
    18
   ],
   "pre": 1,
   "tbl": "jp-"
  },
  {
   "id": "g13.14.019",
   "jp": "ここは少し休んだほうがいい。\nヤツらとの戦い、先は長いからな。\n{wait}",
   "en": "",
   "slots": [
    19
   ],
   "pre": 1
  },
  {
   "id": "g13.14.020",
   "jp": "　　　　　\nもうちょっと骨があると思ったけどね。\n{wait}",
   "en": "",
   "slots": [
    20
   ],
   "pre": 1
  },
  {
   "id": "g13.14.021",
   "jp": "　　　　　\n私たちに勝てる者などいない！\n{wait}",
   "en": "",
   "slots": [
    21
   ],
   "pre": 1
  },
  {
   "id": "g13.14.022",
   "jp": "あはははっ、\nこのボクに勝てると思ってたの？\nこの鏡サマに？　あははははっ。\n{wait}",
   "en": "",
   "slots": [
    22
   ],
   "pre": 1
  },
  {
