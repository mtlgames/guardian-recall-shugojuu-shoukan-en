   "slots": [
    13
   ],
   "pre": 1,
   "tbl": "jp-"
  },
  {
   "id": "g23.11.014",
   "jp": "裕子\n「地脈の異変って？」\n{wait}",
   "en": "",
   "slots": [
    14
   ],
   "pre": 1
  },
  {
